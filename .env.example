# Copy to .env.local for local development. On Vercel, add these under Settings → Environment Variables.
# Everything is optional: without a value, that part runs in demo mode.

# Password for /admin (the leads dashboard). Required in production, or /admin stays locked.
ADMIN_PASSWORD=

# Postgres connection string. Without it, leads are kept in memory and vanish on restart.
# On Vercel: Storage → Create Database → Neon, which fills this in for you.
DATABASE_URL=

# Razorpay keys (Dashboard → Account & Settings → API Keys). Without them, checkout is a demo.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# WhatsApp Cloud API (developers.facebook.com → your app → WhatsApp → API Setup).
# Without them, confirmations are logged and shown as "Demo" in /admin.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=webinar_confirmation
WHATSAPP_TEMPLATE_LANG=en
